# Line endings: simpan LF di repo, checkout sesuai OS
* text=auto

# Batch perlu CRLF agar cmd.exe tidak salah parse
*.bat text eol=crlf
*.cmd text eol=crlf

# Teks yang harus LF di mana saja
*.cs text eol=lf
*.xaml text eol=lf
*.sql text eol=lf
*.json text eol=lf
*.sln text eol=lf
*.md text eol=lf
*.yml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Biner
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.docx binary
*.pdf binary
*.exe binary
*.dll binary
